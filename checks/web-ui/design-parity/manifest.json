{
  "version": 2,
  "$schema_note": "Design-parity manifest for the web-ui check. Each target navigates the authoritative design example through its real UI, validates the expected surface marker, and maps it to the Dioxus route and optional interaction path. Drift remains non-blocking, but a missing or wrong surface is reported and is never saved as a valid target.",
  "settings": {
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "themes": ["dark", "light"],
    "blocking": false,
    "note": "Design drift is reported as a directional gauge only; React (design example) and Dioxus (real UI) are not expected to be pixel-identical. Target navigation and identity validation are required even though visual drift is non-blocking.",
    "compare": {
      "method": "imagemagick-rmse-normalized",
      "resizeWidth": 960,
      "note": "Both screenshots are normalized (resized to a common width, flattened on an opaque background) before ImageMagick `compare -metric RMSE` so the score is a stable perceptual-ish similarity gauge rather than a strict pixel diff."
    }
  },
  "views": [
    {
      "name": "dashboard",
      "route": "/",
      "designMarker": { "selector": ".content[data-screen-label='dashboard']" },
      "dioxusMarker": { "selector": "[data-testid='dashboard']" },
      "designRef": "docs/design/CrystalForge/components/DashboardView.jsx"
    },
    {
      "name": "systems",
      "route": "/systems",
      "designActions": [{ "type": "click", "selector": ".nav-item", "text": "Systems" }],
      "designMarker": { "selector": ".content[data-screen-label='systems']" },
      "dioxusMarker": { "selector": ".page-title", "text": "Systems" },
      "designRef": "docs/design/CrystalForge/components/Systems.jsx"
    },
    {
      "name": "system-detail",
      "route": "/systems",
      "designActions": [
        { "type": "click", "selector": ".nav-item", "text": "Systems", "waitFor": ".sys-card" },
        { "type": "click", "selector": ".sys-card", "waitFor": ".side-panel" },
        { "type": "click", "selector": "button", "text": "Open full detail", "waitFor": ".sd-root[data-screen-label='SystemDetail']" }
      ],
      "designMarker": { "selector": ".sd-root[data-screen-label='SystemDetail']" },
      "dioxusActions": [
        { "type": "click", "selector": "[data-testid='systems-cards'] .sys-card", "waitFor": "[data-testid='systems-side-panel']" },
        { "type": "click", "selector": "button", "text": "Open full detail", "waitFor": "[data-testid='system-detail']" }
      ],
      "dioxusMarker": { "selector": "[data-testid='system-detail']" },
      "designRef": "docs/design/CrystalForge/components/SystemDetail.jsx"
    },
    {
      "name": "builds",
      "route": "/builds",
      "designActions": [{ "type": "click", "selector": ".nav-item", "text": "Builds" }],
