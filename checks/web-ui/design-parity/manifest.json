{
  "version": 3,
  "$schema_note": "Design-parity manifest for the web-ui check. Primary views use real sidebar controls. TASK-440 targets use explicit nested interaction states and map to canonical Dioxus workflow steps. The metric is advisory; reviewers must inspect the retained montages.",
  "settings": {
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "themes": ["dark", "light"],
    "semanticFixture": "../design-fixtures.json",
    "blocking": false,
    "note": "The eight TASK-440 targets produce 16 actual React-vs-Dioxus pixel comparisons. Design drift is a directional advisory gauge only; similarity does not establish visual parity, and reviewers must inspect every montage.",
    "compare": {
      "method": "imagemagick-rmse-normalized",
      "resizeWidth": 960,
      "note": "Each full source capture must match its target viewport. TASK-440 comparisons crop the recorded content surface before normalization so shared shell pixels do not dominate RMSE."
    }
  },
