+// SECURITY: Netrc itself cannot bind credentials to a scheme or port. Parse
+// both origins with curl's URL parser before any handle enters the multi loop.
+// Do not attach parser input to these errors: it may contain userinfo.
+static std::pair<std::string, std::string> cfNetrcOrigin(const std::string & value, bool configured)
+{
+    auto invalid = []() -> void {
+        throw FileTransferError(FileTransfer::Misc, {}, "CF netrc authority requires a credential-free HTTPS origin");
+    };
+    if (value.empty() || std::any_of(value.begin(), value.end(), [](unsigned char c) { return c <= 0x20 || c == 0x7f; }))
+        invalid();
+    auto url = std::unique_ptr<CURLU, decltype(&curl_url_cleanup)>(curl_url(), curl_url_cleanup);
+    if (!url || curl_url_set(url.get(), CURLUPART_URL, value.c_str(), CURLU_DISALLOW_USER) != CURLUE_OK)
+        invalid();
+    auto part = [&](CURLUPart name, unsigned int flags = 0) {
+        char * raw = nullptr;
+        if (curl_url_get(url.get(), name, &raw, flags) != CURLUE_OK)
+            invalid();
+        auto owned = std::unique_ptr<char, decltype(&curl_free)>(raw, curl_free);
+        return std::string(owned.get());
+    };
+    auto scheme = toLower(part(CURLUPART_SCHEME));
+    if (scheme != "https")
+        invalid();
+    auto host = toLower(part(CURLUPART_HOST, CURLU_PUNYCODE));
+    auto port = part(CURLUPART_PORT, CURLU_DEFAULT_PORT);
+    // A scoped IPv6 address's zone is part of its authority, not its hostname.
+    char * rawZone = nullptr;
+    auto zoneResult = curl_url_get(url.get(), CURLUPART_ZONEID, &rawZone, 0);
+    auto zone = std::unique_ptr<char, decltype(&curl_free)>(rawZone, curl_free);
+    if (zoneResult == CURLUE_OK)
+        host += "%" + std::string(zone.get());
+    else if (zoneResult != CURLUE_NO_ZONEID)
+        invalid();
+    if (configured) {
+        if (part(CURLUPART_PATH) != "/")
+            invalid();
+        for (auto name : {CURLUPART_QUERY, CURLUPART_FRAGMENT}) {
+            char * raw = nullptr;
+            auto result = curl_url_get(url.get(), name, &raw, CURLU_GET_EMPTY);
+            auto owned = std::unique_ptr<char, decltype(&curl_free)>(raw, curl_free);
+            if (result != CURLUE_NO_QUERY && result != CURLUE_NO_FRAGMENT)
+                invalid();
+        }
+    }
+    return {host, port};
+}
+
+static void checkCfNetrcAuthority(const FileTransferSettings & settings, const FileTransferRequest & request)
+{
+    if (settings.cfNetrcAuthority.get().empty())
+        return;
+    auto origin = cfNetrcOrigin(settings.cfNetrcAuthority.get(), true);
+    if (cfNetrcOrigin(request.uri.to_string(), false) != origin)
+        throw FileTransferError(FileTransfer::Misc, {}, "CF netrc transfer authority mismatch");
+    // SECURITY: The guarded reader is read-only. It must not authenticate
+    // uploads or S3 operations even if their endpoint shares the read origin.
+    if (request.data || (request.method != HttpMethod::Get && request.method != HttpMethod::Head))
+        throw FileTransferError(FileTransfer::Misc, {}, "CF netrc transfer requires a read request");
+}
+
 } // namespace
 
