  "query": "\n        SELECT id, name, repo_url, branch\n        FROM flakes \n        WHERE repo_url = ANY($1)\n        ORDER BY \n            CASE \n                WHEN repo_url = $2 THEN 1  -- Exact match first\n                ELSE 2\n            END\n        LIMIT 1\n        ",
