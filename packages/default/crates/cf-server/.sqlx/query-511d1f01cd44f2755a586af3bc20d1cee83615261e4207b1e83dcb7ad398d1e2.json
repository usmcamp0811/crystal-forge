{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                rv.id,\n                rv.requirement_id,\n                rv.framework_version_id,\n                rv.external_id,\n                rv.title,\n                rv.kind,\n                rv.severity,\n                rv.parent_requirement_version_id,\n                rv.semantic_digest\n            FROM compliance_requirement_versions rv\n            WHERE rv.framework_version_id = $1\n              AND ($2::TEXT IS NULL OR rv.kind = $2)\n            ORDER BY rv.external_id\n            LIMIT $3 OFFSET $4\n            ",
