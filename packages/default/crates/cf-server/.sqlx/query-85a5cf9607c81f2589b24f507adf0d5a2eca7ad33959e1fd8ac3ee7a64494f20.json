{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            f.id,\n            f.name,\n            f.publisher,\n            f.canonical_source_key,\n            f.description,\n            COUNT(fv.id) AS \"version_count!\"\n        FROM compliance_frameworks f\n        LEFT JOIN compliance_framework_versions fv ON fv.framework_id = f.id\n        GROUP BY f.id\n        ORDER BY f.name\n        ",
